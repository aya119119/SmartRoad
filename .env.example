# SmartRoad Backend Configuration
# ================================
# Copy this file to .env and fill in your API keys
# cp .env.example .env

# ─────────────────────────────────────────────────────────────────────────────
# LLM Configuration
# ─────────────────────────────────────────────────────────────────────────────

# Choose your LLM provider: "groq", "openai", or "mock" (for testing)
LLM_PROVIDER=groq

# Groq API Key (get from https://console.groq.com/keys)
# Used for: Official report generation
GROQ_API_KEY=

# OpenAI API Key (get from https://platform.openai.com/account/api-keys)
# Used as alternative to Groq
OPENAI_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Model Configuration
# ─────────────────────────────────────────────────────────────────────────────

# Detection model (YOLOv8 Hugging Face model ID)
# Default: "keremberke/yolov8n-pothole-segmentation"
# DETECTION_MODEL=keremberke/yolov8n-pothole-segmentation

# Confidence threshold for detections (0.0 - 1.0)
# Default: 0.35 (35%)
# DETECTION_CONFIDENCE=0.35

# Device for model inference: "cpu" or "cuda"
# Default: auto-detect
# DETECTION_DEVICE=cpu

# ─────────────────────────────────────────────────────────────────────────────
# Server Configuration
# ─────────────────────────────────────────────────────────────────────────────

# Backend host and port
# For development: 127.0.0.1:8000
# For production: 0.0.0.0:8000
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend URL (allowed CORS origin)
FRONTEND_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# Application Settings
# ─────────────────────────────────────────────────────────────────────────────

# Application environment: "development" or "production"
ENV=development

# Debug mode (set to False in production)
DEBUG=True

# Maximum file upload size (in MB)
# MAX_UPLOAD_SIZE=10

# ─────────────────────────────────────────────────────────────────────────────
# Database Configuration (future)
# ─────────────────────────────────────────────────────────────────────────────

# DATABASE_URL=postgresql://user:password@localhost/smartroad

# ─────────────────────────────────────────────────────────────────────────────
# Email Configuration (for sending reports)
# ─────────────────────────────────────────────────────────────────────────────

# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
